# ──────────────────────────────────────────────
# Energy Tracker — 環境変数テンプレート
# このファイルをコピーして .env を作成し、
# 実際のキーを設定してください。
# cp .env.example .env
#
# ⚠️  .env は絶対にリポジトリにコミットしないでください。
#    .gitignore に追加済みであることを確認してください。
# ──────────────────────────────────────────────

# ── JWT シークレットキー（必須・本番では必ず変更）────────────────────
# 生成方法: openssl rand -hex 32
# または:   python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  本番環境で JWT_SECRET が未設定の場合はサーバーが起動しません。
JWT_SECRET=ここに32バイト以上のランダム文字列を設定してください

# ── CORS 許可オリジン ────────────────────────────────────────────────
# 本番環境では実際のフロントエンドURLに変更してください（末尾スラッシュ不要）
# 例（本番）: ALLOWED_ORIGINS=https://your-app.example.com
# 例（開発）: ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 開発モード（本番では設定しないこと）─────────────────────────────
# DEBUG=1 の場合: /docs /redoc が有効、JWT未設定での起動を許可、内部IPのCORSを許可
# 本番デプロイ時はこの行をコメントアウトまたは削除してください
# DEBUG=1

# ── OpenRouteService API キー ────────────────────────────────────────
# 取得: https://openrouteservice.org/dev/#/login
# 未設定の場合はルート取得がフォールバック（直線近似）になります
ORS_API_KEY=your_ors_api_key_here

# ── OpenWeatherMap API キー ──────────────────────────────────────────
# 取得: https://openweathermap.org/api
# 未設定の場合は天気情報がデフォルト値になります
OWM_API_KEY=your_owm_api_key_here

# ── AI 自然言語クエリ ────────────────────────────────────────────────
# AI_PROVIDER=auto  # auto | gemini | groq | ollama | none

# Google Gemini (無料枠: 1,500 req/日)
# 取得: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (無料枠: 14,400 req/日・超高速)
# 取得: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here
